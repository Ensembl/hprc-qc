// Nextflow config for HPRC Ensembl vs CAT comparison

params.outdir = './results'
params.ensg_lookup = null

// Conda configuration
conda {
    enabled = false  // Will be enabled with -with-conda flag
    useMicromamba = true
}

manifest {
    name            = 'hprc-ensembl-cat-comparison'
    author          = 'Ensembl Genebuild'
    homePage        = 'https://github.com/ensembl/hprc-qc'
    description     = 'Compare Ensembl and CAT gene annotations for HPRC assemblies'
    mainScript      = 'main.nf'
    nextflowVersion = '>=21.04.0'
    version         = '1.0.0'
}

// Process labels
    process {
        withLabel: process_low {
            cpus   = 1
            memory = 4.GB
            time   = 2.h
        }

        withLabel: process_medium {
            cpus   = 4
            memory = 24.GB
            time   = 6.h
        }

    withLabel: process_high {
        cpus   = 4
        memory = 24.GB
        time   = 8.h
    }

    withLabel: process_very_high {
        cpus   = 4
        memory = 100.GB
        time   = 8.h
    }

    withLabel: process_download {
        cpus   = 1
        memory = 2.GB
        time   = 30.m
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
        maxRetries = 3
    }
}

// Executor configuration
executor {
    name = 'slurm'
    queueSize = 50
    submitRateLimit = '10 sec'
}

// Profile configurations
profiles {
    standard {
        process.executor = 'local'
        process.cpus = 2
        process.memory = '12 GB'
    }

    slurm {
        process.executor = 'slurm'
    }

    test {
        params.max_assemblies = 3
        process.executor = 'local'
    }

    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        // For download-labelled processes use a plain Debian image and install curl
        // Avoid overriding ENTRYPOINT; let Nextflow handle the shell wrapper
        process {
            withLabel: process_download {
                container = 'debian:bookworm-slim'
            }
        }
    }

    singularity {
        singularity.enabled = true
        singularity.autoMounts = false
        // Allow overriding default process containers via params when running with singularity
        // Example: --gffread_container 'docker://quay.io/biocontainers/gffread:0.12.7--hd03093a_1'
        singularity.pullTimeout = '60m'
    }

    localtest {
        process.executor = 'local'
        process.cpus = 2
        process.memory = '12 GB'
        // Relax very high label for local stub runs
        process {
            withLabel: process_very_high {
                memory =  '4 GB'
            }
            withName: AGGREGATE_CODING_INTEGRITY {
                memory = '2 GB'
            }
        }
    }
}

// Report and trace options
timeline {
    enabled = false
    file = "${params.outdir}/reports/timeline.html"
}

report {
    enabled = false
    file = "${params.outdir}/reports/report.html"
}

trace {
    enabled = false
    file = "${params.outdir}/reports/trace.txt"
}

dag {
    enabled = false
    file = "${params.outdir}/reports/dag.svg"
}
